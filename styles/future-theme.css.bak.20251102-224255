/* ===== Power Crypto World — FUTURE THEME (visual-only) =====
   Scope all changes under `.theme-future` so logic/other pages are untouched
*/
.theme-future {
  --pcw-bg: rgba(11, 15, 26, 0.55);
  --pcw-surface: rgba(14, 20, 34, 0.66);
  --pcw-border: rgba(90, 255, 240, 0.18);
  --pcw-hairline: rgba(255, 255, 255, 0.06);

  --pcw-teal: #14F195;
  --pcw-aqua: #00C2FF;
  --pcw-blue: #3BA7FF;
  --pcw-violet: #7C3AED;
  --pcw-magenta: #C026D3;

  --pcw-text: #EAF4FF;
  --pcw-text-dim: #9EB1C8;

  --pcw-radius-lg: 22px;
  --pcw-radius-md: 14px;
  --pcw-blur: 12px;

  --pcw-glow-outer: 0 0 24px rgba(20, 241, 149, .22), 0 0 48px rgba(124, 58, 237, .18);
  --pcw-glow-soft: 0 8px 30px rgba(0, 0, 0, .45);

  color: var(--pcw-text);
}
.theme-future, .theme-future * {
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
/* Card glass */
.theme-future .swapCard,
.theme-future .swap-card,
.theme-future .SwapCard {
  position: relative;
  border-radius: var(--pcw-radius-lg);
  background: var(--pcw-bg);
  backdrop-filter: blur(var(--pcw-blur));
  -webkit-backdrop-filter: blur(var(--pcw-blur));
  border: 1px solid var(--pcw-border);
  box-shadow: var(--pcw-glow-outer), var(--pcw-glow-soft), inset 0 1px var(--pcw-hairline);
  overflow: hidden;
}
.theme-future .swapCard::before,
.theme-future .swap-card::before,
.theme-future .SwapCard::before {
  content: "";
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  padding: 1px;
  background:
    conic-gradient(
      from 0deg,
      var(--pcw-teal),
      var(--pcw-aqua),
      var(--pcw-blue),
      var(--pcw-violet),
      var(--pcw-magenta),
      var(--pcw-teal)
    );
  -webkit-mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
          mask-composite: exclude;
  animation: pcw-spin 10s linear infinite;
  pointer-events: none;
  opacity: .55;
}
@keyframes pcw-spin { to { transform: rotate(360deg); } }
.theme-future .swapCard::after,
.theme-future .swap-card::after,
.theme-future .SwapCard::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background:
    radial-gradient(120% 120% at 10% 0%, rgba(20,241,149,.06), transparent 45%),
    radial-gradient(120% 120% at 100% 100%, rgba(124,58,237,.08), transparent 50%);
  pointer-events: none;
}
/* Tabs */
.theme-future .tabs, 
.theme-future .tablist, 
.theme-future [role="tablist"] {
  display: inline-flex;
  padding: 6px;
  border-radius: 9999px;
  background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.02));
  border: 1px solid rgba(255,255,255,.06);
}
.theme-future .tabs > *,
.theme-future [role="tab"] {
  position: relative;
  border-radius: 9999px;
  padding: 8px 16px;
  color: var(--pcw-text-dim);
  font-weight: 600;
  letter-spacing: .2px;
  transition: color .2s ease, transform .12s ease;
}
.theme-future .tabs > *.active,
.theme-future [role="tab"][aria-selected="true"] {
  color: var(--pcw-text);
  background: radial-gradient(120% 120% at 50% 0%, rgba(20,241,149,.18), rgba(124,58,237,.18));
  box-shadow: 0 0 12px rgba(20,241,149,.25);
}
.theme-future .tabs > *:hover,
.theme-future [role="tab"]:hover { transform: translateY(-1px); }
/* Token rows & inputs */
.theme-future .token-row,
.theme-future .swapRow,
.theme-future .inputRow {
  background: var(--pcw-surface);
  border: 1px solid rgba(255,255,255,.08);
  border-radius: var(--pcw-radius-md);
  padding: 14px 16px;
  box-shadow: inset 0 1px rgba(255,255,255,.04);
}
.theme-future input[type="text"],
.theme-future input[type="number"],
.theme-future .amountInput {
  background: transparent;
  border: none;
  width: 100%;
  text-align: right;
  font-weight: 700;
  font-size: clamp(24px, 3.3vw, 44px);
  color: var(--pcw-text);
  outline: none;
}
.theme-future .usd-sub,
.theme-future .subValue,
.theme-future .fiatLine {
  display: block;
  font-size: .9rem;
  color: var(--pcw-text-dim);
  margin-top: 2px;
}
.theme-future .token-row :is(input,button,select):focus-visible {
  outline: 2px solid color-mix(in lab, var(--pcw-teal) 70%, transparent);
  outline-offset: 2px;
  border-radius: 10px;
}
/* Divider button */
.theme-future .swap-divider,
.theme-future .flipButton {
  width: 44px; height: 44px;
  border-radius: 9999px;
  border: 1px solid rgba(255,255,255,.12);
  background: radial-gradient(110% 110% at 50% 10%, rgba(0,194,255,.25), rgba(20,241,149,.18));
  box-shadow: 0 8px 24px rgba(0,0,0,.45), 0 0 16px rgba(0,194,255,.25) inset;
  display: grid; place-items: center;
  transform: translateY(-8px);
}
/* Chips (slippage/speed) */
.theme-future .chip,
.theme-future .speed-chip,
.theme-future .slippage-chip,
.theme-future .qp-chip,
.theme-future .qp-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,.10);
  background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
  color: var(--pcw-text);
  box-shadow: inset 0 1px rgba(255,255,255,.06);
  font-weight: 600;
}
.theme-future .chip.is-active,
.theme-future .speed-chip.is-active,
.theme-future .slippage-chip.is-active {
  background: radial-gradient(120% 120% at 0% 0%, rgba(20,241,149,.22), rgba(124,58,237,.16));
  box-shadow: 0 0 14px rgba(20,241,149,.25);
}
/* Primary CTA */
.theme-future .primary,
.theme-future .connectButton,
.theme-future button[type="submit"].swap,
.theme-future .SwapButton {
  position: relative;
  width: 100%;
  border-radius: 9999px;
  padding: 16px 20px;
  font-weight: 800;
  letter-spacing: .2px;
  color: #102019;
  background: linear-gradient(180deg, #53FFCF, #14F195);
  box-shadow: 0 8px 28px rgba(20,241,149,.35), inset 0 1px rgba(255,255,255,.65);
  border: 0;
  transform: translateZ(0);
  transition: transform .12s ease, box-shadow .2s ease;
}
.theme-future .primary:hover,
.theme-future .connectButton:hover,
.theme-future button[type="submit"].swap:hover { transform: translateY(-1px) scale(1.01); }
.theme-future .primary:disabled,
.theme-future .connectButton:disabled,
.theme-future button[type="submit"].swap:disabled {
  filter: saturate(.6) brightness(.85);
  cursor: not-allowed;
}
.theme-future .primary:not(:disabled)::after,
.theme-future .connectButton:not(:disabled)::after {
  content:"";
  position:absolute; inset:-2px;
  border-radius: inherit;
  box-shadow: 0 0 24px rgba(20,241,149,.35);
  animation: pcw-breathe 2.5s ease-in-out infinite;
  pointer-events:none;
  opacity:.7;
}
@keyframes pcw-breathe { 0%,100% {opacity:.4;} 50% {opacity:.9;} }
/* Mini tile */
.theme-future .mini-tile, 
.theme-future .chart-tile {
  border-radius: 14px;
  background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.02));
  border: 1px solid rgba(255,255,255,.10);
  box-shadow: 0 10px 32px rgba(0,0,0,.45), 0 0 16px rgba(0,194,255,.22) inset;
}
/* Tooltips */
.theme-future .info,
.theme-future .help,
.theme-future .tooltip {
  color: var(--pcw-text-dim);
  border-color: rgba(255,255,255,.18);
}
/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  .theme-future .swapCard::before { animation: none; }
  .theme-future .primary:not(:disabled)::after { animation: none; }
}
