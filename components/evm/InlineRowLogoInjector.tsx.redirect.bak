"use client";
import { useEffect } from "react";

/** Build prioritized logo URLs (CDN API → local SVG → local PNG). */
function buildSources(chainId: string, address: string): string[] {
  const c = String(chainId).trim();
  const a = String(address).trim().toLowerCase();
  return [
    `/api/evm-logo?chainId=${encodeURIComponent(c)}&address=${encodeURIComponent(a)}&prefer=cdn`,
    `/token-logos/${c}/${a}.svg`,
    `/token-logos/${c}/${a}.png`
  ];
}

/** Pick a sensible anchor near the token name; otherwise use row. */
function chooseAnchor(row: HTMLElement): HTMLElement {
  const leaves = Array.from(row.querySelectorAll<HTMLElement>('*')).filter(el => el.childElementCount === 0);
  const dashLeaf = leaves.find(el => /—/.test(el.textContent ?? ''));
  if (dashLeaf?.parentElement) return dashLeaf.parentElement as HTMLElement;

  const addrLeaf = leaves.find(el => /0x[a-f0-9]{6,}/i.test(el.textContent ?? ''));
  if (addrLeaf?.parentElement?.previousElementSibling) {
    const prev = addrLeaf.parentElement.previousElementSibling as HTMLElement;
    const txt = (prev.textContent ?? "").trim();
    if (txt && !/0x[a-f0-9]{6,}/i.test(txt)) return prev;
  }
  const firstText = leaves.find(el => (el.textContent ?? "").trim());
  return firstText?.parentElement ?? row;
}

/** Inject exactly one logo into a single row, if not already injected. */
function injectLogoOnce(row: HTMLElement) {
  const chainId = row.getAttribute('data-chain-id')?.trim();
  const address = row.getAttribute('data-address')?.trim()?.toLowerCase();
  if (!chainId || !address) return;

  const markAttr = 'data-logo-injected';
  const mark = `${chainId}:${address}`;
  if (row.getAttribute(markAttr) === mark) return; // already injected

  // If any old injected logos exist, remove them once (avoid doubles)
  row.querySelectorAll('img.pcw-inline-token-logo').forEach(n => n.remove());

  const anchor = chooseAnchor(row);
  const img = document.createElement('img');
  img.className = 'pcw-inline-token-logo';
  img.alt = 'token logo';
  Object.assign(img.style, {
    width: '24px',
    height: '24px',
    borderRadius: '6px',
    verticalAlign: 'middle',
    marginRight: '8px',
    boxShadow: '0 0 0 1px rgba(255,255,255,0.18) inset',
    display: 'inline-block',
    objectFit: 'cover',
    pointerEvents: 'none',
  } as CSSStyleDeclaration);

  const srcs = buildSources(chainId, address);
  let i = 0;
  const tryNext = () => {
    if (i >= srcs.length) { img.remove(); return; }
    img.src = srcs[i++];
  };
  img.onerror = tryNext;
  tryNext();

  anchor.insertBefore(img, anchor.firstChild);
  row.setAttribute(markAttr, mark);
}

export default function InlineRowLogoInjector() {
  useEffect(() => {
    // Initial pass: inject for any existing rows
    document
      .querySelectorAll<HTMLElement>('[data-chain-id][data-address]')
      .forEach(injectLogoOnce);

    // Observe for newly added rows (no polling, no flicker)
    const observer = new MutationObserver((mutations) => {
      for (const m of mutations) {
        // rows added directly
        m.addedNodes.forEach((node) => {
          if (!(node instanceof HTMLElement)) return;
          if (node.matches?.('[data-chain-id][data-address]')) {
            injectLogoOnce(node);
          }
          // rows added inside containers
          node
            .querySelectorAll?.('[data-chain-id][data-address]')
            .forEach((el: Element) => injectLogoOnce(el as HTMLElement));
        });

        // attribute changes on rows (e.g., same row reused with new address)
        if (m.type === 'attributes' && (m.target as HTMLElement).matches?.('[data-chain-id][data-address]')) {
          injectLogoOnce(m.target as HTMLElement);
        }
      }
    });

    observer.observe(document.body, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['data-chain-id', 'data-address'],
    });

    return () => observer.disconnect();
  }, []);

  return null;
}
