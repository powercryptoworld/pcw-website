"use client";

import React, { useMemo, useState } from "react";
import { useEvmQuote, type Addr, type GasSpeed } from "@/hooks/useEvmQuote";

type TokenRef = { address: Addr; decimals: number; symbol?: string; name?: string };

export function QuotePanel({
  chainId,
  src,
  dst,
  amount,
  defaultSlippageBps = 50, // 0.50%
  defaultGasSpeed = "fast",
}: {
  chainId: number;
  src: TokenRef;
  dst: TokenRef;
  amount: string;
  defaultSlippageBps?: number;
  defaultGasSpeed?: GasSpeed;
}) {
  const [slippageBps, setSlippageBps] = useState<number>(defaultSlippageBps);
  const [gasSpeed, setGasSpeed] = useState<GasSpeed>(defaultGasSpeed);

  const { loading, error, data } = useEvmQuote({
    chainId,
    src,
    dst,
    amount,
    slippageBps,
    includeProtocols: true,
    gasSpeed,
  });

  const slippageDisplay = useMemo(() => (slippageBps / 100).toFixed(2) + "%", [slippageBps]);
  const slipPresets = [
    { label: "0.10%", bps: 10 },
    { label: "0.50%", bps: 50 },
    { label: "1.00%", bps: 100 },
  ];
  const speedPresets: { label: string; key: GasSpeed }[] = [
    { label: "Standard", key: "standard" },
    { label: "Fast", key: "fast" },
    { label: "Instant", key: "instant" },
  ];

  return (
    <div className="mt-4 rounded-2xl border border-white/10 bg-white/5 backdrop-blur p-4">
      <div className="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between mb-3">
        <div className="text-sm opacity-75">Quote details</div>
        <div className="flex flex-wrap items-center gap-3">
          <div className="flex items-center gap-2">
            <span className="text-xs opacity-70">Slippage</span>
            <div className="flex items-center gap-1">
              {slipPresets.map((p) => (
                <button
                  key={p.bps}
                  onClick={() => setSlippageBps(p.bps)}
                  className={`px-2 py-1 rounded-md text-xs border transition ${
                    slippageBps === p.bps ? "border-white/60 bg-white/20" : "border-white/10 hover:border-white/30"
                  }`}
                >
                  {p.label}
                </button>
              ))}
              <div className="flex items-center gap-1">
                <input
                  type="number"
                  inputMode="decimal"
                  min={0}
                  step="0.01"
                  placeholder={slippageDisplay}
                  className="w-20 rounded-md bg-black/20 border border-white/10 px-2 py-1 text-xs"
                  onChange={(e) => {
                    const v = Math.max(0, Number(e.target.value || 0));
                    setSlippageBps(Math.round(v * 100)); // % -> bps
                  }}
                />
                <span className="text-xs opacity-70">%</span>
              </div>
            </div>
          </div>

          <div className="flex items-center gap-2">
            <span className="text-xs opacity-70">Speed</span>
            <div className="flex items-center gap-1">
              {speedPresets.map((s) => (
                <button
                  key={s.key}
                  onClick={() => setGasSpeed(s.key)}
                  className={`px-2 py-1 rounded-md text-xs border transition ${
                    gasSpeed === s.key ? "border-white/60 bg-white/20" : "border-white/10 hover:border-white/30"
                  }`}
                >
                  {s.label}
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div className="grid grid-cols-2 gap-3 text-sm">
        <div className="rounded-xl border border-white/10 p-3 bg-black/10">
          <div className="opacity-70">Price impact</div>
          <div className="mt-1 text-base">
            {loading ? "…" : error ? "—" : data?.priceImpactPct != null ? `${data.priceImpactPct}%` : "—"}
          </div>
        </div>
        <div className="rounded-xl border border-white/10 p-3 bg-black/10">
          <div className="opacity-70">Estimated gas</div>
          <div className="mt-1 text-base">
            {loading
              ? "…"
              : error
              ? "—"
              : data?.gas != null
              ? `${data.gas} units${data?.gasUsd != null ? `  (≈ $${data.gasUsd.toFixed(2)})` : ""}`
              : "—"}
          </div>
          <div className="mt-1 text-[10px] opacity-60">
            {gasSpeed.charAt(0).toUpperCase() + gasSpeed.slice(1)} price used when quote lacks gasPrice.
          </div>
        </div>
        <div className="col-span-2 rounded-xl border border-white/10 p-3 bg-black/10">
          <div className="opacity-70">Route</div>
          <div className="mt-1 text-base break-words">
            {loading ? "…" : error ? "—" : data?.routeSummary || "—"}
          </div>
        </div>
      </div>

      {error ? <div className="mt-3 text-xs text-red-300">{error}</div> : null}
    </div>
  );
}

export default QuotePanel;
