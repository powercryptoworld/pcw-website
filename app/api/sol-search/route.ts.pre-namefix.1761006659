import { NextRequest, NextResponse } from "next/server";

export const dynamic = "force-dynamic";

type T = {
  address?: string;
  mint?: string;
  symbol?: string;
  name?: string;
  decimals?: number | null;
  logoURI?: string | null;
  chainId?: number | null;
};

// Accept slightly longer base58 runs; some UIs add a char or suffix.
// Also allow weirder pastes (whitespace, mixed text) by extracting the first base58-looking run.
const BASE58_RE = /[1-9A-HJ-NP-Za-km-z]{32,50}/g; // was 32–44

function extractMint(input: string): string | null {
  const s = (input || "").trim();
  if (!s) return null;
  const m = s.match(BASE58_RE);
  if (!m || m.length === 0) return null;
  // Prefer a run in the classic 32–44 range if present; else take the first match.
  const classic = m.find(x => x.length >= 32 && x.length <= 44);
  return classic || m[0];
}

function normalize(list: T[] = []) {
  return list
    .map((t) => ({
      mint: t.address || t.mint || "",
      symbol: t.symbol || "UNKNOWN",
      name: t.name || "Token",
      decimals: typeof t.decimals === "number" ? t.decimals : null,
      logoURI: t.logoURI || null,
      chainId: typeof t.chainId === "number" ? t.chainId : 101,
    }))
    .filter((x) => x.mint);
}

function takeArrayShape(payload: any): T[] {
  if (Array.isArray(payload)) return payload as T[];
  if (payload?.data && Array.isArray(payload.data)) return payload.data as T[];
  if (payload?.items && Array.isArray(payload.items)) return payload.items as T[];
  return [];
}

async function fetchJSON(url: string, timeoutMs = 8000) {
  const r = await fetch(url, {
    cache: "no-store",
    redirect: "follow",
    signal: AbortSignal.timeout(timeoutMs),
    headers: { accept: "application/json", "user-agent": "pcw-sol-search/1.6" },
  });
  if (!r.ok) throw new Error(`upstream ${r.status}`);
  return r.json();
}

// DexScreener helpers
function dsMintToItem(ds: any, mint: string): T | null {
  const pairs = Array.isArray(ds?.pairs) ? ds.pairs : [];
  const exact = pairs.find((p: any) => p?.baseToken?.address === mint);
  const src = exact || pairs[0];
  if (!src?.baseToken) return null;
  const base = src.baseToken;
  const imageUrl: string | null =
    typeof ds?.info?.imageUrl === "string" && ds.info.imageUrl.length ? ds.info.imageUrl : null;
  return {
    address: mint,
    mint,
    symbol: base.symbol || undefined,
    name: base.name || undefined,
    decimals: null,
    logoURI: imageUrl,
    chainId: 101,
  };
}

export async function GET(req: NextRequest) {
  try {
    const { searchParams } = new URL(req.url);
    const qRaw = (searchParams.get("q") || "").trim();
    if (!qRaw) return NextResponse.json({ items: [] }, { status: 200 });

    const jupBase = (process.env.NEXT_PUBLIC_JUPITER_LITE || "https://lite-api.jup.ag").replace(/\/+$/, "");

    // If input contains a mint-looking substring, treat it as a mint search (DexScreener-first)
    const mint = extractMint(qRaw);

    if (mint) {
      // 1) DexScreener for immediate symbol/name (works for newborn tokens)
      let dsItem: T | null = null;
      try {
        const ds = await fetchJSON(`https://api.dexscreener.com/latest/dex/tokens/${encodeURIComponent(mint)}`, 8000);
        dsItem = dsMintToItem(ds, mint);
      } catch {}

      // 2) Jupiter registry for confirmation/fallback
      let regItems: any[] = [];
      try {
        const ultra = await fetchJSON(`${jupBase}/ultra/v1/search?query=${encodeURIComponent(mint)}`);
        regItems = normalize(takeArrayShape(ultra));
      } catch {}
      if (regItems.length === 0) {
        try {
          const reg = await fetchJSON(`https://tokens.jup.ag/tokens?search=${encodeURIComponent(mint)}`);
          regItems = normalize(takeArrayShape(reg));
        } catch {}
      }
      const exact = regItems.filter((x) => x.mint === mint);
      if (exact.length > 0) regItems = exact;

      let items: any[] = [];
      if (dsItem && (dsItem.symbol || dsItem.name)) {
        items = normalize([dsItem]);
      } else if (regItems.length > 0) {
        items = regItems;
      } else {
        items = normalize([{ address: mint }]);
      }

      return NextResponse.json({ items }, { status: 200, headers: { "Cache-Control": "public, max-age=60" } });
    }

    // Otherwise, normal text search (SOL, USDC, bonk...)
    let items: any[] = [];
    try {
      const ultra = await fetchJSON(`${jupBase}/ultra/v1/search?query=${encodeURIComponent(qRaw)}`);
      items = normalize(takeArrayShape(ultra)).slice(0, 50);
    } catch {}
    if (items.length === 0) {
      try {
        const reg = await fetchJSON(`https://tokens.jup.ag/tokens?search=${encodeURIComponent(qRaw)}`);
        items = normalize(takeArrayShape(reg)).slice(0, 50);
      } catch {}
    }

    return NextResponse.json({ items }, { status: 200, headers: { "Cache-Control": "public, max-age=60" } });
  } catch (e: any) {
    return NextResponse.json({ items: [], error: e?.message || "error" }, { status: 200 });
  }
}
