:root{ --sol-cyan:#34ffd6; --sol-purple:#7a5cff; --neon-pink:#ff2fb0; }

/* Nuke any pseudo/spotlight/filters ON THE CARD ONLY */
.theme-future .glass.swapCard::before,
.theme-future .glass.swapCard::after{
  content:none !important; background:none !important; box-shadow:none !important;
  -webkit-mask:none !important; mask:none !important; filter:none !important;
}

/* The card glass: subtle, no blobs */
.theme-future .glass.swapCard{
  background: linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.03)) !important;
  border: 1px solid rgba(122,92,255,.25) !important;
  box-shadow: inset 0 0 1px rgba(255,255,255,.12), 0 10px 24px rgba(0,0,0,.28) !important;
  backdrop-filter: blur(8px) !important;
}

/* Futuristic pills/buttons – SCOPED TO THE CARD ONLY */
.theme-future .glass.swapCard :is(button,[role="button"],.pill,.speed-pill){
  border-radius: 9999px !important;
  border: 1px solid rgba(122,92,255,.45) !important;
  background: linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.03)) !important;
  color:#eaf2ff !important;
  padding:.42rem .8rem !important; line-height:1 !important; letter-spacing:.2px !important;
  box-shadow: inset 0 0 .5px rgba(255,255,255,.22) !important;
  transition: transform .14s, box-shadow .18s, background .18s, border-color .18s !important;
}
.theme-future .glass.swapCard :is(button,[role="button"],.pill,.speed-pill):hover,
.theme-future .glass.swapCard :is(button,[role="button"],.pill,.speed-pill):focus-visible{
  transform: translateY(-1px) !important;
  border-color: rgba(122,92,255,.70) !important;
  box-shadow: inset 0 0 .5px rgba(255,255,255,.28), 0 0 14px rgba(52,255,214,.28), 0 0 20px rgba(122,92,255,.22) !important;
  outline: none !important;
}
.theme-future .glass.swapCard :is(.pill-active,.active,[aria-pressed="true"]){
  border-color: rgba(122,92,255,.85) !important;
  background: linear-gradient(180deg, rgba(52,255,214,.20), rgba(122,92,255,.22)) !important;
  color:#fff !important;
}

/* Inputs inside the card */
.theme-future .glass.swapCard :is(input,select){
  border-radius:12px !important;
  border:1px solid rgba(122,92,255,.35) !important;
  background: rgba(0,0,0,.30) !important;
  color:#f6f9ff !important;
  box-shadow: inset 0 0 .5px rgba(255,255,255,.18) !important;
}
.theme-future .glass.swapCard :is(input,select):focus{
  border-color: rgba(122,92,255,.60) !important;
  box-shadow: inset 0 0 .5px rgba(255,255,255,.26), 0 0 12px rgba(52,255,214,.22) !important;
  outline:none !important;
}

/* === RESET NEON OUTSIDE THE GLASS CARD ============================== */
/* Header / Nav buttons (top row) */
.theme-future header :is(button,[role="button"],.pill,[class*="pill"],[class*="chip"]),
.theme-future nav :is(button,[role="button"],.pill,[class*="pill"],[class*="chip"]) {
  border: 1px solid rgba(255,255,255,.14) !important;
  background: rgba(14,16,20,.55) !important;
  box-shadow: none !important;
  transform: none !important;
  backdrop-filter: none !important;
  filter: none !important;
  color: #eaf2ff !important;
}

/* Social Dock icons (bottom left) */
.theme-future :is(.social-dock,#social-dock,.SocialDock) :is(button,[role="button"],.pill,[class*="pill"],[class*="chip"]),
.theme-future :is(.social-dock,#social-dock,.SocialDock) a {
  border: 1px solid rgba(255,255,255,.14) !important;
  background: rgba(14,16,20,.55) !important;
  box-shadow: none !important;
  transform: none !important;
  backdrop-filter: none !important;
  filter: none !important;
}

/* Contact button (bottom right) */
.theme-future :is(.contact-dock,#contact-dock,.ContactDock,.contact-glow) :is(button,[role="button"],.pill,[class*="pill"],[class*="chip"]),
.theme-future :is(.contact-dock,#contact-dock,.ContactDock,.contact-glow) a {
  border: 1px solid rgba(255,255,255,.14) !important;
  background: rgba(14,16,20,.55) !important;
  box-shadow: none !important;
  transform: none !important;
  backdrop-filter: none !important;
  filter: none !important;
}

/* Keep neon ONLY inside .glass.swapCard (already defined above) */
/* ==================================================================== */
/* ================== KILL NEON OUTSIDE THE GLASS SWAP CARD ================== */
/* Header / nav bar (top) */
.theme-future header *,
.theme-future nav * {
  box-shadow: none !important;
  filter: none !important;
  backdrop-filter: none !important;
}
.theme-future header :is(a,button,[role="button"],.pill,[class*="pill"],[class*="chip"],.px-3),
.theme-future nav    :is(a,button,[role="button"],.pill,[class*="pill"],[class*="chip"],.px-3) {
  border: 1px solid rgba(255,255,255,.14) !important;
  background: rgba(14,16,20,.55) !important;
  color: #eaf2ff !important;
  transform: none !important;
}

/* Social dock (bottom-left) */
.theme-future :is([class*="SocialDock"],[class*="social-dock"],#social-dock,.social-dock, .SocialDock) * {
  box-shadow: none !important;
  filter: none !important;
  backdrop-filter: none !important;
}
.theme-future :is([class*="SocialDock"],[class*="social-dock"],#social-dock,.social-dock, .SocialDock)
:is(a,button,[role="button"],.pill,[class*="pill"],[class*="chip"]) {
  border: 1px solid rgba(255,255,255,.14) !important;
  background: rgba(14,16,20,.55) !important;
  transform: none !important;
}

/* Contact dock (bottom-right) */
.theme-future :is([class*="ContactDock"],[class*="contact-dock"],#contact-dock,.contact-dock, .ContactDock, .contact-glow) * {
  box-shadow: none !important;
  filter: none !important;
  backdrop-filter: none !important;
}
.theme-future :is([class*="ContactDock"],[class*="contact-dock"],#contact-dock,.contact-dock, .ContactDock, .contact-glow)
:is(a,button,[role="button"],.pill,[class*="pill"],[class*="chip"]) {
  border: 1px solid rgba(255,255,255,.14) !important;
  background: rgba(14,16,20,.55) !important;
  transform: none !important;
}

/* IMPORTANT: we keep neon **only** inside the swap glass card (already styled elsewhere) */
/* =========================================================================== */
