  letter-spacing: .2px;
  backdrop-filter: blur(6px);
  transition: transform .14s ease, box-shadow .18s ease, background .18s ease, border-color .18s ease;
  -webkit-tap-highlight-color: transparent;
  white-space: nowrap;
}

.theme-future .swapCard :where(.pill, button, [role="button"]):hover,
.theme-future .swapCard :where(.pill, button, [role="button"]):focus-visible {
  transform: translateY(-1px);
  box-shadow:
    0 0 12px color-mix(in oklab, var(--sol-cyan, #34ffd6) 28%, transparent),
    0 0 20px color-mix(in oklab, var(--sol-purple, #7a5cff) 22%, transparent);
  border-color: color-mix(in oklab, var(--sol-purple, #7a5cff) 50%, white 0%);
}

.theme-future .swapCard :where(.pill-active, .active, [aria-pressed="true"]) {
  border-color: color-mix(in oklab, var(--sol-purple, #7a5cff) 64%, white 0%);
  background:
    linear-gradient(180deg, color-mix(in oklab, var(--sol-cyan, #34ffd6) 24%, transparent), color-mix(in oklab, var(--sol-purple, #7a5cff) 34%, transparent)),
    radial-gradient(120% 140% at 100% 0%, color-mix(in oklab, var(--neon-pink, #ff2fb0) 18%, transparent), transparent 60%);
  box-shadow:
    inset 0 0 1px rgba(255,255,255,.28),
    0 0 18px color-mix(in oklab, var(--sol-cyan, #34ffd6) 30%, transparent),
    0 0 26px color-mix(in oklab, var(--sol-purple, #7a5cff) 26%, transparent);
  color: #fff;
}

.theme-future .swapCard :where(.pill, button, [role="button"]):focus-visible {
  outline: none;
  box-shadow:
    0 0 0 2px color-mix(in oklab, var(--sol-cyan, #34ffd6) 60%, transparent),
    0 0 0 4px color-mix(in oklab, var(--sol-purple, #7a5cff) 42%, transparent);
}
/* === END PCW NEON PILLS v2 === */

/* === PCW NEON PILLS v3 — force override inside the swap card === */
.theme-future .glass.swapCard :is(.pill, .speed-pill, button, [role="button"]) {
  border-radius: 9999px !important;
  border: 1px solid color-mix(in oklab, var(--sol-cyan,#34ffd6) 48%, white 0%) !important;
  background:
    linear-gradient(180deg, rgba(255,255,255,.10), rgba(255,255,255,.04)) ,
    radial-gradient(120% 140% at 0% 0%, color-mix(in oklab, var(--sol-cyan,#34ffd6) 26%, transparent) 0%, transparent 60%) !important;
  box-shadow:
    inset 0 0 0.5px rgba(255,255,255,.28),
    0 0 12px color-mix(in oklab, var(--sol-cyan,#34ffd6) 26%, transparent),
    0 0 18px color-mix(in oklab, var(--sol-purple,#7a5cff) 20%, transparent) !important;
  color: #eaf2ff !important;
  padding: .44rem .84rem !important;
  line-height: 1 !important;
  letter-spacing: .2px !important;
  backdrop-filter: blur(6px) !important;
  transition: transform .14s ease, box-shadow .18s ease, background .18s ease, border-color .18s ease !important;
  -webkit-tap-highlight-color: transparent !important;
  white-space: nowrap !important;
}

.theme-future .glass.swapCard :is(.pill, .speed-pill, button, [role="button"]):hover,
.theme-future .glass.swapCard :is(.pill, .speed-pill, button, [role="button"]):focus-visible{
  transform: translateY(-1px) !important;
  border-color: color-mix(in oklab, var(--sol-purple,#7a5cff) 60%, white 0%) !important;
  box-shadow:
    inset 0 0 0.5px rgba(255,255,255,.28),
    0 0 16px color-mix(in oklab, var(--sol-cyan,#34ffd6) 30%, transparent),
    0 0 24px color-mix(in oklab, var(--sol-purple,#7a5cff) 28%, transparent) !important;
}

.theme-future .glass.swapCard :is(.pill-active, .active, [aria-pressed="true"]){
  border-color: color-mix(in oklab, var(--sol-purple,#7a5cff) 70%, white 0%) !important;
  background:
    linear-gradient(180deg, color-mix(in oklab, var(--sol-cyan,#34ffd6) 28%, transparent), color-mix(in oklab, var(--sol-purple,#7a5cff) 36%, transparent)),
    radial-gradient(120% 140% at 100% 0%, color-mix(in oklab, var(--neon-pink,#ff2fb0) 22%, transparent), transparent 62%) !important;
  color:#fff !important;
}
/* === END v3 === */

.theme-future .glass .pill{outline:3px solid lime !important}
/* ==== PCW NEON UI v2 — scoped, high-specificity, important ==== */
.theme-future .glass.swapCard :is(button,[role="button"],.pill,.speed-pill){
  position:relative !important;
  border-radius:9999px !important;
  border:1px solid rgba(122,92,255,.70) !important;
  background:
    linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.03)),
    radial-gradient(120% 140% at 0% 0%, rgba(52,255,214,.22), transparent 60%) !important;
  color:#eaf2ff !important;
  padding:.48rem .9rem !important;
  line-height:1 !important;
  letter-spacing:.2px !important;
  backdrop-filter: blur(8px) !important;
  transition: transform .14s ease, box-shadow .18s ease, background .18s ease, border-color .18s ease !important;
  box-shadow:
    inset 0 0 1px rgba(255,255,255,.28),
    0 0 14px rgba(52,255,214,.34),
    0 0 22px rgba(122,92,255,.24) !important;
}

.theme-future .glass.swapCard :is(button,[role="button"],.pill,.speed-pill):hover,
.theme-future .glass.swapCard :is(button,[role="button"],.pill,.speed-pill):focus-visible{
  transform: translateY(-1px) !important;
  border-color:#7a5cff !important;
  box-shadow:
    inset 0 0 1px rgba(255,255,255,.30),
    0 0 18px rgba(52,255,214,.42),
    0 0 28px rgba(122,92,255,.32) !important;
  color:#ffffff !important;
}

.theme-future .glass.swapCard :is(.pill-active,.active,[aria-pressed="true"]){
  border-color:#b29aff !important;
  background:
    linear-gradient(180deg, rgba(52,255,214,.26), rgba(122,92,255,.34)),
    radial-gradient(120% 140% at 100% 0%, rgba(255,47,176,.24), transparent 62%) !important;
  box-shadow:
    inset 0 0 1px rgba(255,255,255,.32),
    0 0 20px rgba(52,255,214,.36),
    0 0 30px rgba(122,92,255,.30) !important;
  color:#fff !important;
}

/* Inputs to match the glass card */
.theme-future .glass.swapCard :is(input,select){
  border-radius:12px !important;
  border:1px solid rgba(122,92,255,.55) !important;
  background: rgba(0,0,0,.30) !important;
  color:#f6f9ff !important;
  box-shadow: inset 0 0 1px rgba(255,255,255,.24), 0 0 10px rgba(52,255,214,.16) !important;
}
.theme-future .glass.swapCard :is(input,select):focus{
  outline:none !important;
  border-color:#7a5cff !important;
  box-shadow: inset 0 0 1px rgba(255,255,255,.30), 0 0 16px rgba(122,92,255,.28) !important;
}
/* ==== end PCW NEON UI v2 ==== */
